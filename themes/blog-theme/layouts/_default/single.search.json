[{{ range $i, $p := where .Site.RegularPages "Type" "posts" }}{{ if $i }},{{ end }}{{ $summary := $p.Summary | plainify | replaceRE "[\\s]+" " " | truncate 180 "…" }}{{ dict "title" $p.Title "url" $p.RelPermalink "summary" $summary "tags" $p.Params.tags "date" ($p.Date.Format "2006-01-02") "readingTime" $p.ReadingTime "pinned" $p.Params.pinned | jsonify }}{{ end }}]
