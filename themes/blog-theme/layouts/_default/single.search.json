[{{ range $i, $p := where .Site.RegularPages "Type" "posts" }}{{ if $i }},{{ end }}{{ $summary := $p.Summary | plainify | replaceRE "[\\s]+" " " | truncate 180 "…" }}{{ $tagLinks := dict }}{{ range $p.Params.tags }}{{ $tagLinks = merge $tagLinks (dict . (printf "/tags/%s/" (urlize .))) }}{{ end }}{{ dict "title" $p.Title "url" $p.RelPermalink "summary" $summary "tags" $p.Params.tags "tagLinks" $tagLinks "date" ($p.Date.Format "2006-01-02") "readingTime" $p.ReadingTime "pinned" $p.Params.pinned | jsonify }}{{ end }}]
