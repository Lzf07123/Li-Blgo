{{ $brand := hugo.Data.brand }}
{{ $pages := where .Site.RegularPages.ByDate.Reverse "Section" "posts" }}
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>{{ $brand.name }}</title>
  <link>{{ .Site.Home.Permalink }}</link>
  <description>{{ $brand.tagline }}。{{ $brand.promise }}</description>
  <atom:link href="{{ .Site.Home.Permalink }}index.xml" rel="self" type="application/rss+xml"/>
  <lastBuildDate>{{ now.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>
  <copyright>{{ replace $brand.copyright "{year}" (now.Format "2006") }}</copyright>
  {{ range first 20 $pages }}
  <item>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <guid isPermaLink="true">{{ .Permalink }}</guid>
    <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
    {{ with .Params.tags }}{{ range . }}<category>{{ . }}</category>{{ end }}{{ end }}
    <description>{{ .Summary }}</description>
  </item>
  {{ end }}
</channel>
</rss>
