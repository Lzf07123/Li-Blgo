# Li&Blog 环境变量模板：复制为 .env 后填写（.env 不进 git）

# 后台路径（默认 admin；改后需同步 nginx/default.conf）
ADMIN_PATH=admin
ADMIN_SESSION_SECRET=
# 启用 HTTPS 前保持 0；TLS 就绪后改为 1（HTTP 下 Secure Cookie 会导致无法登录）
COOKIE_SECURE=0

# 路径（容器内默认即可）
DB_PATH=/app/data/blog.db
CONTENT_ROOT=/app/content
OUTPUT_ROOT=/app/output
PREVIEW_ROOT=/app/.preview-out
BEACON_LOG=/app/beacon/beacon.log
MEDIA_ROOT=/app/themes/blog-theme/static/img

# Li&Pass OIDC（留空则 OIDC 登录禁用）
LIPASS_ISSUER=
LIPASS_CLIENT_ID=
LIPASS_CLIENT_SECRET=
LIPASS_REDIRECT_URI=
ADMIN_IP_WHITELIST=

# 构建内存与并行度
GOMEMLIMIT=256MiB
HUGO_NUMWORKERMULTIPLIER=0.5

# 文章批量导入限制
IMPORT_MAX_FILES=200
IMPORT_MAX_FILE_BYTES=2097152
IMPORT_MAX_ZIP_BYTES=20971520

# 备份恢复限制
RESTORE_MAX_FILES=5000
RESTORE_MAX_BYTES=104857600

# 部署域名（必填）：如 https://blog.example.cn/
# 留空时构建产物 canonical/OG/RSS 使用相对地址，禁止再出现 example.com 占位
SITE_BASEURL=

# ---- 软件源与镜像加速变量（compose 自动透传，admin 构建走 --build-arg）----
# Docker Hub 镜像加速：DOCKER_MIRROR_PREFIX 为镜像名前缀（如 docker.m.daocloud.io/，须以 / 结尾；留空=官方源）
# 另可在 Docker daemon 配置 registry-mirrors 作为兜底
DOCKER_MIRROR_PREFIX=
# apt 镜像主机（去掉协议）：mirrors.tuna.tsinghua.edu.cn / mirrors.aliyun.com
APT_MIRROR=deb.debian.org
# pip 镜像
PIP_INDEX_URL=https://pypi.org/simple
# Hugo 二进制（v0.165.0）已随仓库提交于 bin/hugo/，构建期 COPY + SHA256 校验，不联网下载
